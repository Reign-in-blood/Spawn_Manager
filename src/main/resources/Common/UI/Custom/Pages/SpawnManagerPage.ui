$C = "../Common.ui";

// Custom Styles
@RadiusButtonStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultSquareButtonDefaultBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Disabled: (Background: $C.@DefaultSquareButtonDisabledBackground, LabelStyle: $C.@DefaultButtonDisabledLabelStyle),
  Sounds: $C.@ButtonSounds,
);

@CollabButtonStyle = TextButtonStyle(
  Default: (Background: #2a3545, LabelStyle: (FontSize: 13, TextColor: #7eb8d4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3a4555, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1a2535, LabelStyle: (FontSize: 13, TextColor: #7eb8d4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@FilterButtonStyle = TextButtonStyle(
  Default: (Background: #2b3542, LabelStyle: (FontSize: 13, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b4552, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1b2532, LabelStyle: (FontSize: 13, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@FilterActiveStyle = TextButtonStyle(
  Default: (Background: #1a3d2e, LabelStyle: (FontSize: 13, TextColor: #4aff7f, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #2a4d3e, LabelStyle: (FontSize: 13, TextColor: #6aff9f, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #0a2d1e, LabelStyle: (FontSize: 13, TextColor: #4aff7f, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 680);

    #Title {
      $C.@Title {
        @Text = "SPAWN MANAGER";
      }
    }

    #Content {
      Padding: (Vertical: 10, Horizontal: 15);
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        Group #LeftPane {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #151e28;
          Padding: (Full: 10);

          Label {
            Text: "MOBS";
            Anchor: (Height: 18);
            Style: (FontSize: 11, TextColor: #5a7a8a, RenderBold: true, RenderUppercase: true);
          }

          Group { Anchor: (Height: 8); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 36);

            $C.@TextField #MobSearchField {
              Anchor: (Width: 250, Height: 34);
              PlaceholderText: "Search mobs...";
              Style: $C.@DefaultInputFieldStyle;
            }

            Group { Anchor: (Width: 4); }

            $C.@TextButton #SearchBtn {
              @Text = "Search";
              Anchor: (Width: 110, Height: 34);
            }

            Group { Anchor: (Width: 4); }

            $C.@SecondaryTextButton #ClearSearchBtn {
              @Text = "Clear";
              Anchor: (Width: 110, Height: 34);
            }
          }

          Group { Anchor: (Height: 8); }

          Group #MobListContainer {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Background: #0a1119;
            Padding: (Full: 2);
          }
        }

        Group { Anchor: (Width: 12); }

        Group #RightPane {
          Anchor: (Width: 420);
          LayoutMode: Top;
          FlexWeight: 1;

          Group #FilterSection {
            LayoutMode: Top;
            Background: #151e28;
            Padding: (Full: 10);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 26);

              Group {
                LayoutMode: Middle;
                Anchor: (Width: 96, Height: 26);

                TextButton #FilterPASSIVEOff {
                  Text: "PAS";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterButtonStyle;
                }

                TextButton #FilterPASSIVEOn {
                  Text: "PAS";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterActiveStyle;
                }
              }

              Group { Anchor: (Width: 4); }

              Group {
                LayoutMode: Middle;
                Anchor: (Width: 96, Height: 26);

                TextButton #FilterAGGRESSIVEOff {
                  Text: "AGR";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterButtonStyle;
                }

                TextButton #FilterAGGRESSIVEOn {
                  Text: "AGR";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterActiveStyle;
                }
              }

              Group { Anchor: (Width: 4); }

              Group {
                LayoutMode: Middle;
                Anchor: (Width: 96, Height: 26);

                TextButton #FilterMONSTEROff {
                  Text: "MON";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterButtonStyle;
                }

                TextButton #FilterMONSTEROn {
                  Text: "MON";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterActiveStyle;
                }
              }
            }

            Group { Anchor: (Height: 4); }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 26);

              Group {
                LayoutMode: Middle;
                Anchor: (Width: 96, Height: 26);

                TextButton #FilterANIMALSOff {
                  Text: "ANIMALS";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterButtonStyle;
                }

                TextButton #FilterANIMALSOn {
                  Text: "ANIMALS";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterActiveStyle;
                }
              }

              Group { Anchor: (Width: 4); }

              Group {
                LayoutMode: Middle;
                Anchor: (Width: 96, Height: 26);

                TextButton #FilterENEMIESOff {
                  Text: "ENEMIES";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterButtonStyle;
                }

                TextButton #FilterENEMIESOn {
                  Text: "ENEMIES";
                  Anchor: (Width: 96, Height: 26);
                  Style: @FilterActiveStyle;
                }
              }
            }

            Group { Anchor: (Height: 10); }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34);

              $C.@TextButton #ApplyButton {
                @Text = "Apply";
                Anchor: (Width: 160, Height: 34);
              }

              Group { Anchor: (Width: 4); }

              $C.@SecondaryTextButton #ReloadNpcButton {
                @Text = "Reload NPC";
                Anchor: (Width: 160, Height: 34);
              }
            }
          }

          Group { FlexWeight: 1; }

          Group #BulkSelectionSection {
            LayoutMode: Top;
            Background: #151e28;
            Padding: (Full: 10);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 26);

              $C.@TextButton #SelectAllButton {
                @Text = "Select All";
                Anchor: (Width: 96, Height: 26);
              }

              Group { Anchor: (Width: 4); }

              $C.@SecondaryTextButton #ClearAllButton {
                @Text = "Clear All";
                Anchor: (Width: 96, Height: 26);
              }
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
