$C = "../Common.ui";

Group {
  LayoutMode: Top;
  FlexWeight: 1;

  Group {
    LayoutMode: Left;
    Anchor: (Height: 44);
    Background: #1e293b;
    Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);

    $C.@TextField #MobSearchField {
      Anchor: (Width: 260, Height: 36);
      PlaceholderText: "Search mobs...";
      Style: $C.@DefaultInputFieldStyle;
    }

    Group { Anchor: (Width: 6); }

    $C.@TextButton #SearchBtn {
      @Text = "FIND";
      Anchor: (Width: 120, Height: 36);
    }

    Group { Anchor: (Width: 4); }

    $C.@SecondaryTextButton #ClearSearchBtn {
      @Text = "CLEAR";
      Anchor: (Width: 130, Height: 36);
    }
  }

  Group { Anchor: (Height: 4); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 20);
    Padding: (Left: 4, Right: 4);

    Label {
      Text: "SEL";
      Anchor: (Width: 30, Height: 20);
      Style: (FontSize: 9, TextColor: #6a7988, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Group { Anchor: (Width: 4); }

    Label {
      Text: "MOB NAME";
      Anchor: (Width: 280, Height: 20);
      Style: (FontSize: 9, TextColor: #6a7988, RenderBold: true, VerticalAlignment: Center);
    }

    Group { FlexWeight: 1; }

    Label {
      Text: "TYPE";
      Anchor: (Width: 80, Height: 20);
      Style: (FontSize: 9, TextColor: #6a7988, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }

  Group { Anchor: (Height: 1); Background: #2a3a4a; }

  Group #MobListContainer {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Background: #0a1119;
    Padding: (Full: 2);
  }
}
